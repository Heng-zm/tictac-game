# ---------------------------------------------------------------------------
# Tic Tac Toe Telegram Mini App — example environment
# Copy this file to `.env` and fill in the values you need.
# Never commit `.env` or real bot tokens/secrets.
# ---------------------------------------------------------------------------

# development | test | production
NODE_ENV=development
PORT=3000

# PostgreSQL connection string. Required in production.
# Leave empty during local UI work to use the in-memory repository.
# The in-memory repository is refused as a production fallback.
#
# Supabase (recommended for production):
#   DATABASE_URL = transaction pooler, port 6543:
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require
#   DIRECT_URL   = session pooler, port 5432, used only by migrations. Do not use
#                  the direct db.<project-ref>.supabase.co host on Render: it is IPv6-only.
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
#
# SUPABASE_URL / SUPABASE_KEY / SUPABASE_SERVICE_ROLE_KEY are NOT used by this
# app. The server talks to Supabase PostgreSQL directly through Prisma; it does
# not use the Supabase Data API or Supabase Auth. Do not add those keys to the
# server environment.
# Optional: postgres | memory. Leave unset to use postgres when DATABASE_URL is
# set, otherwise memory. In production, DB_MODE=memory is explicit and
# ephemeral: all data is lost when the server restarts. Telegram auth is still
# required.
# DB_MODE=memory
#
# Demo mode: guest login + in-memory data. On Render this is enabled
# automatically when neither DATABASE_URL nor TELEGRAM_BOT_TOKEN is set.
# Production demo mode must stay ephemeral: it cannot be combined with
# DATABASE_URL. Set DEMO_MODE=false to require real configuration instead.
# DEMO_MODE=true
#
# Local PostgreSQL example:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tictactoe?schema=public
DATABASE_URL=
DIRECT_URL=

# At least 32 characters. Required in production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# The example value below is intentionally rejected in production.
SESSION_SECRET=change-me-to-a-random-32-plus-character-secret

# Public HTTPS origin of the Mini App in production (no trailing slash needed).
MINI_APP_URL=http://localhost:5173

# Telegram bot credentials. The token is server-only and must never be exposed
# to the browser. Set both in production.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Optional Telegram webhook. If omitted the bot uses long polling.
# On Render, the URL is derived automatically and this secret is derived from
# SESSION_SECRET unless you set it explicitly. The HTTP webhook route is only
# mounted when both a webhook URL and secret are configured.
# TELEGRAM_WEBHOOK_URL=https://game.example.com/api/telegram/webhook
TELEGRAM_WEBHOOK_URL=
# Required when TELEGRAM_WEBHOOK_URL is set; 16-256 chars, letters/digits/_/-.
TELEGRAM_WEBHOOK_SECRET=

# Local guest sign-in for development only. The server refuses this in
# production and when NODE_ENV=production.
DEV_AUTH_ENABLED=true

# Comma-separated browser origins allowed to call the API / open sockets.
# The MINI_APP_URL origin is allowed automatically.
CORS_ORIGINS=http://localhost:5173

# Matchmaking
QUEUE_AI_TIMEOUT_MS=10000
QUEUE_MAX_WAIT_MS=600000

# Maximum simultaneous authenticated Socket.IO connections per account.
MAX_SOCKETS_PER_USER=5

# Presence and turn timing. TURN_TIMEOUT_MS=0 disables turn timers.
DISCONNECT_GRACE_MS=30000
TURN_TIMEOUT_MS=90000

# Invitations and Telegram initData freshness
INVITE_TTL_MINUTES=1440
AUTH_MAX_AGE_SECONDS=86400

# Bot thinking delay range (milliseconds)
AI_THINK_MIN_MS=350
AI_THINK_MAX_MS=850
# Difficulty used for the queue's "play a bot" fallback.
AI_FALLBACK_DIFFICULTY=MEDIUM

# Background cleanup
MAINTENANCE_INTERVAL_MS=3600000
MATCH_STALE_AFTER_MS=86400000

# Logging and reverse-proxy configuration
LOG_LEVEL=info
# Set to the number of trusted reverse-proxy hops in production, e.g. 1.
TRUST_PROXY=0
